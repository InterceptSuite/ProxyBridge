[Desktop Entry]
Type=Application
Name=ProxyBridge
Comment=Universal proxy client for Linux applications
Exec=/usr/local/bin/ProxyBridgeGUI
Icon=proxybridge
Terminal=false
Categories=Network;Security;
StartupWMClass=ProxyBridgeGUI
StartupNotify=false
# The GUI needs root (start it with sudo), so it is not offered in the application grid; this file gives the running window its
# name and icon in the dock.
NoDisplay=true
